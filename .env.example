# Secrets — never commit real values.
# Real runs inject secrets in memory via HACKATONS/tools/with-secrets.ps1:
#   -Only "ENV_USER_INFERHUB_API_KEY,SCAN_ELEVENLABS_1,SCAN_ELEVENLABS_2"
# The application reads these injected names directly; no .env file is needed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_BASE_URL=https://api.inferhub.dev/v1
LLM_MODEL=combo/cheap
LLM_MAX_INPUT_PRICE=0.01
LLM_MAX_OUTPUT_PRICE=0.05
TTS_PROVIDER=elevenlabs
TTS_API_KEY=
ELEVENLABS_VOICE_ID=hUgFhs9U5VcF4E65CSsv

# Local storage (project .data folder)
DATA_DIR=.data

# S3-compatible storage (optional, V2)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Database (optional, V2 — demo mode uses a JSON store)
DATABASE_URL=

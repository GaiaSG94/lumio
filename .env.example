# Secrets — ne jamais committer de vraies valeurs.
# Les runs reels injectent les secrets en memoire via HACKATONS/tools/with-secrets.ps1 :
#   -Only "ENV_USER_INFERHUB_API_KEY,SCAN_ELEVENLABS_1,SCAN_ELEVENLABS_2"
# L'application lit directement ces noms injectes ; aucun .env n'est necessaire.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_BASE_URL=https://api.inferhub.dev/v1
LLM_MODEL=combo/cheap
LLM_MAX_INPUT_PRICE=0.01
LLM_MAX_OUTPUT_PRICE=0.05
TTS_PROVIDER=elevenlabs
TTS_API_KEY=
ELEVENLABS_VOICE_ID=hUgFhs9U5VcF4E65CSsv

# Stockage local (dossier .data du projet)
DATA_DIR=.data

# Stockage S3-compatible ( optionnel, V2 )
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Base de donnees (optionnelle, V2 — le demo mode utilise un store JSON)
DATABASE_URL=
